# Copy this file to terraform.tfvars in a disposable test environment.
gcp_project_id      = "replace-with-gcp-project-id"
gcp_region          = "us-central1"
aws_profile          = "replace-with-aws-sso-profile"
aws_region           = "us-east-1"
admin_cidr           = "203.0.113.10/32"
ssh_public_key_path  = "~/.ssh/lighthouse_key.pub"
dr_mode_active       = false
